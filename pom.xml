<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.jrules</groupId>
    <artifactId>ruleengine-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ruleengine-parent</name>
    <description>Parent POM for the rule engine project</description>

    <modules>
        <module>ruleengine-v1</module>
        <module>ruleengine-v2</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <antlr4.version>4.13.1</antlr4.version>
        <aws.sdk.version>2.25.29</aws.sdk.version>
        <lombok.version>1.18.32</lombok.version>
        <zalando.version>0.29.1</zalando.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
