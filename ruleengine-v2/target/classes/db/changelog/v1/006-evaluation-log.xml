<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-evaluation-log" author="system">
        <createTable tableName="evaluation_log">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="policy_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="policy_version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="policy_def_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(10)" defaultValue="SUCCESS">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(100)"/>
            <column name="error_message" type="TEXT"/>
            <column name="context" type="LONGTEXT"/>
            <column name="result" type="LONGTEXT"/>
            <column name="trace_level" type="VARCHAR(10)"/>
            <column name="duration_ms" type="BIGINT"/>
            <column name="evaluated_by" type="VARCHAR(100)"/>
            <column name="evaluated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="evaluation_log" indexName="idx_eval_log_policy_id">
            <column name="policy_id"/>
            <column name="evaluated_at" descending="true"/>
        </createIndex>

        <createIndex tableName="evaluation_log" indexName="idx_eval_log_policy_version">
            <column name="policy_id"/>
            <column name="policy_version"/>
            <column name="evaluated_at" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
