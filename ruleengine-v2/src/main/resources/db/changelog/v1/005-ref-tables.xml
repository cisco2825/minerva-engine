<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-policy-table-ref" author="system">
        <createTable tableName="policy_table_ref">
            <column name="policy_def_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="table_def_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="policy_table_ref"
                columnNames="policy_def_id, table_def_id"
                constraintName="pk_policy_table_ref"/>

        <addForeignKeyConstraint
                baseTableName="policy_table_ref" baseColumnNames="policy_def_id"
                referencedTableName="policy_definition" referencedColumnNames="id"
                constraintName="fk_ptr_policy"/>

        <addForeignKeyConstraint
                baseTableName="policy_table_ref" baseColumnNames="table_def_id"
                referencedTableName="table_definition" referencedColumnNames="id"
                constraintName="fk_ptr_table"/>
    </changeSet>

    <changeSet id="005-create-policy-lookup-ref" author="system">
        <createTable tableName="policy_lookup_ref">
            <column name="policy_def_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="lookup_def_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="policy_lookup_ref"
                columnNames="policy_def_id, lookup_def_id"
                constraintName="pk_policy_lookup_ref"/>

        <addForeignKeyConstraint
                baseTableName="policy_lookup_ref" baseColumnNames="policy_def_id"
                referencedTableName="policy_definition" referencedColumnNames="id"
                constraintName="fk_plr_policy"/>

        <addForeignKeyConstraint
                baseTableName="policy_lookup_ref" baseColumnNames="lookup_def_id"
                referencedTableName="lookup_definition" referencedColumnNames="id"
                constraintName="fk_plr_lookup"/>
    </changeSet>

    <changeSet id="005-create-policy-udf-ref" author="system">
        <createTable tableName="policy_udf_ref">
            <column name="policy_def_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="udf_def_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="policy_udf_ref"
                columnNames="policy_def_id, udf_def_id"
                constraintName="pk_policy_udf_ref"/>

        <addForeignKeyConstraint
                baseTableName="policy_udf_ref" baseColumnNames="policy_def_id"
                referencedTableName="policy_definition" referencedColumnNames="id"
                constraintName="fk_pur_policy"/>

        <addForeignKeyConstraint
                baseTableName="policy_udf_ref" baseColumnNames="udf_def_id"
                referencedTableName="udf_definition" referencedColumnNames="id"
                constraintName="fk_pur_udf"/>
    </changeSet>

</databaseChangeLog>
