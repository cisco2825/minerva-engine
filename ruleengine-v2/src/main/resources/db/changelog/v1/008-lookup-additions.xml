<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="008-lookup-description" author="system">
        <addColumn tableName="lookup_definition">
            <column name="description" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="008-lookup-soft-delete" author="system">
        <addColumn tableName="lookup_definition">
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="lookup_definition" indexName="idx_lookup_definition_deleted">
            <column name="deleted"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
